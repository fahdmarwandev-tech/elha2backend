# =============================================================================
# GAME3 AL-HAQ BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PostgreSQL Database Container Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourSecureDatabasePassword123!
POSTGRES_DB=game3alhaq_db

# -----------------------------------------------------------------------------
# 2. Spring Boot Datasource Configuration
# In docker-compose, this points to the internal 'db' service name on port 5432.
# -----------------------------------------------------------------------------
DB_LOCAL_URL=jdbc:postgresql://db:5432/game3alhaq_db
DB_LOCAL_USERNAME=postgres
DB_LOCAL_PASSWORD=YourSecureDatabasePassword123!

# -----------------------------------------------------------------------------
# 3. Server Port Configuration
# Default internal port is 8080 (mapped to host 8082 in docker-compose.prod.yml)
# -----------------------------------------------------------------------------
SERVER_PORT=8080

# -----------------------------------------------------------------------------
# 4. Security & JWT Configuration
# JWT_SECRET must be at least 256 bits (32 characters / 64 hex characters)
# -----------------------------------------------------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=14

# -----------------------------------------------------------------------------
# 5. File Upload Configuration
# Stored locally inside the container at /app/uploads (mounted to host ./uploads)
# -----------------------------------------------------------------------------
UPLOAD_DIR=/app/uploads
UPLOAD_BASE_URL=/uploads

# -----------------------------------------------------------------------------
# 6. CORS Configuration
# Comma-separated list of allowed origins (e.g., Cloudflare Pages domain and localhost)
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=https://game3alhaq.pages.dev,https://game3alhaq.com,http://localhost:3000

# -----------------------------------------------------------------------------
# 7. SMTP Mail Configuration (Password Reset & OTP notifications)
# -----------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# -----------------------------------------------------------------------------
# 8. PayPal Payment Gateway Configuration (sandbox or live)
# -----------------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# -----------------------------------------------------------------------------
# 9. YouTube Data API Configuration (Mosque Lectures / Media Ingestion)
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
# 10. Docker Image (GHCR Container Image Name for VPS Deployment)
# -----------------------------------------------------------------------------
BACKEND_IMAGE=ghcr.io/fahdmarwandev-tech/elha2backend:latest
